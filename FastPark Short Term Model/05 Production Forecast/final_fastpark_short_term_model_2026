def load_and_clean_production_data(config: dict, sql_engine) -> Dict[str, pd.DataFrame]:
    """
    Loads and cleans all necessary historical data up to the current run date.
    This data forms the basis for calculating forecast components.

    Parameters:
        config (dict): The global configuration dictionary (`PRODUCTION_CONFIG`).
        sql_engine: The SQLAlchemy engine for database connection.

    Returns:
        Dict[str, pd.DataFrame]: A dictionary containing cleaned bookings, operations,
                                 flights, master, daily actuals, hourly actuals,
                                 daily passenger context, and historical curves.
    """
    current_run_date = pd.to_datetime(config["current_run_date"]).normalize()
    history_start_date = config["history_start_date"]

    # The end date for all historical data is the current run date.
    history_end_date = current_run_date.strftime("%Y-%m-%d")

    # Load raw data.
    bookings_raw = get_fastpark_bookings(
        start=history_start_date,
        end=history_end_date,
        statuses=[config["valid_booking_status"], config["cancelled_status"], "F"],
        asset_name=config["asset_name"],
        engine=sql_engine,
    )
    operations_raw = get_fastpark_entry_exits(
        start=history_start_date,
        end=history_end_date,
        engine=sql_engine,
    )
    flights_raw = get_historical_flight_performance(
        start=history_start_date,
        end=history_end_date,
        engine=sql_engine,
    )

    # Clean raw data.
    bookings_clean = clean_bookings(bookings_raw, config)
    operations_clean = clean_operations(operations_raw, config)
    flights_clean = clean_flights(flights_raw, config)

    # Reconcile bookings and operations.
    master_df = reconcile_bookings_to_operations(bookings_clean, operations_clean)

    # Create daily and hourly FastPark actuals.
    daily_actuals_df = create_daily_fastpark_actuals(master_df)
    hourly_actuals_df = create_hourly_fastpark_actuals(master_df)

    # Create daily passenger context.
    daily_passenger_context_df = create_daily_passenger_context(flights_clean)

        # Build historical booking curves.
    # The `forecast_horizons_list` needs to include all possible lead_days from 0 to 56.
    # This list will be used to calculate booking curve completion ratios for all relevant horizons.
    forecast_horizons_list = list(range(config["forecast_lookahead_days"] + 1))

    entry_booking_curve = build_historical_booking_curve(
        bookings=bookings_clean,
        master=master_df,
        target_field="entryDate",
        actual_field="actual_entry_ts",
        cutoff_days=forecast_horizons_list,
    )
    exit_booking_curve = build_historical_booking_curve(
        bookings=bookings_clean,
        master=master_df,
        target_field="exitDate",
        actual_field="actual_exit_ts",
        cutoff_days=forecast_horizons_list,
    )
    duration_exit_booking_curve = build_historical_duration_exit_curve(
        bookings=bookings_clean,
        master=master_df,
        cutoff_days=forecast_horizons_list,
        config=config,
    )

    # Prepare cancellation booking data (if enabled)
    cancellation_bookings_prepared = pd.DataFrame()
    if config.get("enable_cancellation_test", False):
        cancellation_bookings_prepared = prepare_cancellation_booking_data(
            bookings=bookings_clean,
            config=config,
        )

    return {
        "bookings_clean": bookings_clean,
        "operations_clean": operations_clean, # Not directly used in forecast, but good for context.
        "flights_clean": flights_clean, # Not directly used in forecast, but good for context.
        "master_df": master_df,
        "daily_actuals_df": daily_actuals_df,
        "hourly_actuals_df": hourly_actuals_df,
        "daily_passenger_context_df": daily_passenger_context_df,
        "entry_booking_curve": entry_booking_curve,
        "exit_booking_curve": exit_booking_curve,
        "duration_exit_booking_curve": duration_exit_booking_curve,
        "cancellation_bookings_prepared": cancellation_bookings_prepared,
    }


class ProductionForecastData:
    """
    A container class to hold all pre-loaded and pre-processed data
    needed for the production forecast. This avoids passing many
    individual DataFrames to functions.
    """
    def __init__(self, data: Dict[str, pd.DataFrame], config: Dict[str, Any]):
        self.config = config
        self.bookings_clean = data["bookings_clean"]
        self.master_df = data["master_df"]
        self.daily_actuals_df = data["daily_actuals_df"]
        self.hourly_actuals_df = data["hourly_actuals_df"]
        self.daily_passenger_context_df = data["daily_passenger_context_df"]
        self.entry_booking_curve = data["entry_booking_curve"]
        self.exit_booking_curve = data["exit_booking_curve"]
        self.duration_exit_booking_curve = data["duration_exit_booking_curve"]
        self.cancellation_bookings_prepared = data["cancellation_bookings_prepared"]

        # Load learned weights and parameters
        self.forecast_weights = pd.read_csv(config["forecast_weights_path"])
        self.forecast_parameters = pd.read_csv(config["forecast_parameters_path"])
        self.forecast_component_parameters = pd.read_csv(
            config["forecast_component_parameters_path"]
        )

        # Pre-process parameters for faster lookup
        self._prepare_parameters()

        run_date = pd.to_datetime(config["current_run_date"]).normalize()
        calendar = build_calendar_table(
            run_date,
            run_date + pd.Timedelta(days=config["forecast_lookahead_days"]),
            MANUAL_CALENDAR_PERIODS,
        )
        self.calendar_lookup = calendar.set_index("target_date").to_dict(orient="index")

        # Cache for frequently accessed historical values to avoid redundant calculations
        self.cache: Dict[Tuple, Any] = {
            "known_booking_cache": {},
            "curve_factor_cache": {},
            "same_weekday_history_cache": {},
            "weekday_month_history_cache": {},
        }

    def _prepare_parameters(self):
        """
        Build lookup tables compatible with the generated production CSV files.

        The production files generated by the helper scripts use either:
        - the simplified format from create_forecast_parameters.py, or
        - the older detailed format with parameter_type / weekday / band columns.

        We support both so that the script remains robust across model exports.
        """
        self.weights_lookup = self.forecast_weights.set_index(
            ["demand_type", "horizon_days"]
        ).to_dict(orient="index")

        param_df = self.forecast_parameters.copy()
        param_df["flow"] = param_df.get("flow", param_df.get("demand_type", pd.Series(index=param_df.index, dtype=object)))
        param_df["flow"] = param_df["flow"].astype(str).str.lower()

        self.historical_window_lookup = {}
        if {"flow", "horizon_days", "same_weekday_history"}.issubset(param_df.columns):
            self.historical_window_lookup = (
                param_df[["flow", "horizon_days", "same_weekday_history"]]
                .dropna(subset=["same_weekday_history"])
                .set_index(["flow", "horizon_days"])["same_weekday_history"]
                .to_dict()
            )
        elif {"demand_type", "horizon_days", "selected_historical_window"}.issubset(param_df.columns):
            self.historical_window_lookup = (
                param_df[["demand_type", "horizon_days", "selected_historical_window"]]
                .dropna(subset=["selected_historical_window"])
                .set_index(["demand_type", "horizon_days"])["selected_historical_window"]
                .to_dict()
            )

        self.hourly_profile_window_lookup = {}
        if {"flow", "horizon_days", "hourly_profile_window"}.issubset(param_df.columns):
            self.hourly_profile_window_lookup = (
                param_df[["flow", "horizon_days", "hourly_profile_window"]]
                .dropna(subset=["hourly_profile_window"])
                .set_index(["flow", "horizon_days"])["hourly_profile_window"]
                .to_dict()
            )
        elif {"demand_type", "horizon_days", "profile_weeks"}.issubset(param_df.columns):
            self.hourly_profile_window_lookup = (
                param_df[["demand_type", "horizon_days", "profile_weeks"]]
                .dropna(subset=["profile_weeks"])
                .set_index(["demand_type", "horizon_days"])["profile_weeks"]
                .to_dict()
            )

        self.pace_adjustment_lookup = {}
        if {"flow", "horizon_days", "pace_adjustment"}.issubset(param_df.columns):
            self.pace_adjustment_lookup = (
                param_df[["flow", "horizon_days", "pace_adjustment"]]
                .dropna(subset=["pace_adjustment"])
                .set_index(["flow", "horizon_days"])["pace_adjustment"]
                .to_dict()
            )
        elif {"demand_type", "horizon_days", "weekday", "pace_band", "adjustment"}.issubset(param_df.columns):
            self.pace_adjustment_lookup = (
                param_df[["demand_type", "horizon_days", "weekday", "pace_band", "adjustment"]]
                .dropna(subset=["adjustment"])
                .set_index(["demand_type", "horizon_days", "weekday", "pace_band"])["adjustment"]
                .to_dict()
            )

        self.cancellation_adjustment_lookup = {}
        if {"flow", "horizon_days", "cancellation_adjustment"}.issubset(param_df.columns):
            self.cancellation_adjustment_lookup = (
                param_df[["flow", "horizon_days", "cancellation_adjustment"]]
                .dropna(subset=["cancellation_adjustment"])
                .set_index(["flow", "horizon_days"])["cancellation_adjustment"]
                .to_dict()
            )
        elif {"demand_type", "horizon_days", "weekday", "cancellation_band", "adjustment"}.issubset(param_df.columns):
            self.cancellation_adjustment_lookup = (
                param_df[["demand_type", "horizon_days", "weekday", "cancellation_band", "adjustment"]]
                .dropna(subset=["adjustment"])
                .set_index(["demand_type", "horizon_days", "weekday", "cancellation_band"])["adjustment"]
                .to_dict()
            )

        self.horizon_component_lookup = {}
        if {"flow", "horizon_days", "winner_experiment"}.issubset(param_df.columns):
            self.horizon_component_lookup = (
                param_df[["flow", "horizon_days", "winner_experiment"]]
                .dropna(subset=["winner_experiment"])
                .set_index(["flow", "horizon_days"])["winner_experiment"]
                .to_dict()
            )

        component_df = self.forecast_component_parameters.copy()
        component_df["flow"] = component_df["flow"].astype(str).str.lower()

        self.pace_median_lookup = (
            component_df.loc[component_df["parameter_type"].eq("pace_median")]
            .set_index(["flow", "horizon_days", "weekday"])["parameter_value"]
            .to_dict()
        )
        self.cancellation_median_lookup = (
            component_df.loc[
                component_df["parameter_type"].eq("cancellation_median")
            ]
            .set_index(["flow", "horizon_days", "weekday"])["parameter_value"]
            .to_dict()
        )
        self.pace_adjustment_lookup = (
            component_df.loc[
                component_df["parameter_type"].eq("pace_adjustment")
            ]
            .set_index(["flow", "horizon_days", "weekday", "band"])[
                "parameter_value"
            ]
            .to_dict()
        )
        self.cancellation_adjustment_lookup = (
            component_df.loc[
                component_df["parameter_type"].eq("cancellation_adjustment")
            ]
            .set_index(["flow", "horizon_days", "weekday", "band"])[
                "parameter_value"
            ]
            .to_dict()
        )
        self.calendar_adjustment_lookup = (
            component_df.loc[
                component_df["parameter_type"].eq("calendar_adjustment")
            ]
            .set_index(["flow", "horizon_days", "category"])["parameter_value"]
            .to_dict()
        )
        self.regime_adjustment_lookup = (
            component_df.loc[
                component_df["parameter_type"].eq("regime_adjustment")
            ]
            .set_index(["flow", "horizon_days", "band"])["parameter_value"]
            .to_dict()
        )
        self.regime_edges_lookup = {}
        regime_edges = component_df[
            component_df["parameter_type"].eq("regime_edge")
        ]
        if not regime_edges.empty:
            for key, group in regime_edges.groupby(["flow", "horizon_days"]):
                self.regime_edges_lookup[key] = np.concatenate(
                    ([-np.inf], group.sort_values("edge_index")["parameter_value"].to_numpy(dtype=float), [np.inf])
                )


