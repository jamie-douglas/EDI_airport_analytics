# --- Secrets & environments -------------------------------------------------
.env
.venv/
venv/
*.egg-info/
build/

# --- Python / Jupyter / editor ----------------------------------------------
__pycache__/
*.pyc
.ipynb_checkpoints/
.vscode/

# --- Inputs and outputs are never committed ---------------------------------
# (the empty folders are kept with a .gitkeep file)
**/inputs/**
**/outputs/**
**/Outputs/**
!**/inputs/.gitkeep
!**/outputs/.gitkeep
!**/Outputs/.gitkeep

# --- Caches, logs, Office temp files, autosaves -----------------------------
*.pkl
**/.forecast_cache/
*.log
~$*
*__bak_*

# --- Safety net: no data files anywhere... ----------------------------------
*.xlsx
*.xls
*.csv
*.parquet
# ...except small model config the code needs (e.g. forecast_weights.csv)
!**/config/*.csv
