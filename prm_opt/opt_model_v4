import pandas as pd
import numpy as np
from ortools.sat.python import cp_model

# ==========================================
# 1. GLOBAL ENGINE CONFIGURATION & PARAMETERS
# ==========================================
config = {
    # Financial Fleet Cost Parameters (Section 2)
    "capex_ambulift": 400000,           # C_v for Ambulift
    "capex_minibus": 80000,             # C_v for Minibus 
    "capex_pusher": 0,                  # Pushers have 0 capex 

    # Vehicle Capacity Parameters (Section 2)
    "cap_ambulift_seat": 6,             # Cap_{v,seat} 
    "cap_ambulift_wc": 2,               # cap_{v,wc} (Wheelchair tie-downs)
    "cap_minibus_seat": 12,             # Cap_{v,seat}
    "cap_minibus_wc": 4,                # cap_{v,wc} (Wheelchair tie-downs)

    # Operational Durations and Buffers (Section 2)
    "duration_ambulift_solo": 19,       # \tau_{amb,solo} 
    "duration_combined_ambulift": 14,   # \tau_{amb,comb} 
    "duration_minibus_transit": 14,     # \tau_{mini} 
    "duration_pusher_transit": 15,      # \tau_{push} 
    "handover_buffer_mins": 5,          # \beta 

    # Staffing FTE Parameters (From previous conversation rules)
    "staff_fixed_ambulift": 2,          # Crew per Ambulift
    "staff_fixed_minibus": 2,           # Crew per Minibus
    "staff_per_prm_pusher": 1,          # Crew per pusher passenger

    # SLA Target Parameters (Section 2)
    "sla_target_window": 20,            # T_{SLA} 
    "sla_max_hard_limit": 60            # H_{SLA} 
}

# ==========================================
# 2. RAW PASSENGER-LEVEL DATASET
# ==========================================
# Your starting operational data is at the individual passenger level
passenger_rows = [
    # Flight 1: Arrival, Domestic, Remote, Needs Lift due to WCHC passenger
    {"flight_key": "FL001", "passenger_id": "P1", "SSR_Code": "WCHC", "has_own_chair": 1, "Is_Arrival": 1, "Sector_Domestic": 1, "IsRemote": 1, "IsEffectiveRemote": 1, "safety_stand": 0, "Chocks_DT_mins": 60, "Boarding_DT_mins": 0, "is_spin": 1, "spin_parent_key": ""},
    {"flight_key": "FL001", "passenger_id": "P2", "SSR_Code": "WCHR", "has_own_chair": 0, "Is_Arrival": 1, "Sector_Domestic": 1, "IsRemote": 1, "IsEffectiveRemote": 1, "safety_stand": 0, "Chocks_DT_mins": 60, "Boarding_DT_mins": 0, "is_spin": 1, "spin_parent_key": ""},
    
    # Flight 2: Departure, Spin child of FL001. Safety stand.
    {"flight_key": "FL002", "passenger_id": "P3", "SSR_Code": "WCHS", "has_own_chair": 0, "Is_Arrival": 0, "Sector_Domestic": 1, "IsRemote": 0, "IsEffectiveRemote": 0, "safety_stand": 1, "Chocks_DT_mins": 0, "Boarding_DT_mins": 130, "is_spin": 1, "spin_parent_key": "FL001"},
    
    # Flight 3: Arrival, International, Pier Stand, High volume requiring multiple vehicles
    {"flight_key": "FL003", "passenger_id": "P4", "SSR_Code": "WCHC", "has_own_chair": 1, "Is_Arrival": 1, "Sector_Domestic": 0, "IsRemote": 0, "IsEffectiveRemote": 1, "safety_stand": 0, "Chocks_DT_mins": 120, "Boarding_DT_mins": 0, "is_spin": 0, "spin_parent_key": ""},
    {"flight_key": "FL003", "passenger_id": "P5", "SSR_Code": "WCHC", "has_own_chair": 1, "Is_Arrival": 1, "Sector_Domestic": 0, "IsRemote": 0, "IsEffectiveRemote": 1, "safety_stand": 0, "Chocks_DT_mins": 120, "Boarding_DT_mins": 0, "is_spin": 0, "spin_parent_key": ""},
    {"flight_key": "FL003", "passenger_id": "P6", "SSR_Code": "WCHC", "has_own_chair": 1, "Is_Arrival": 1, "Sector_Domestic": 0, "IsRemote": 0, "IsEffectiveRemote": 1, "safety_stand": 0, "Chocks_DT_mins": 120, "Boarding_DT_mins": 0, "is_spin": 0, "spin_parent_key": ""},
]
passenger_df = pd.DataFrame(passenger_rows)

# ==========================================
# 3. MATHEMATICAL DATA AGGREGATION PHASE
# ==========================================
flight_group = passenger_df.groupby("flight_key")

aggregated_flights = []
for f_id, group in flight_group:
    # Extract flight-level constants
    f_meta = group.iloc[0]
    
    # 1. Compute exact categorical demands (Section 2 - Flight properties)
    d_wchc = int(np.sum(group["SSR_Code"] == "WCHC")) # D_{f,WCHC} [cite: 28]
    d_wchs = int(np.sum(group["SSR_Code"] == "WCHS")) # D_{f,WCHS} [cite: 29]
    d_own_chair = int(np.sum(group["has_own_chair"] == 1)) # D_{f,own_chair} [cite: 30]
    total_prms = len(group)
    d_seat = total_prms - d_own_chair # D_{f,seat} [cite: 32]
    
    # 2. Derive the exact Vertical Lift Requirement Rule (Section 3)
    # NeedVertical = 1 if D_{f,WCHC} > 0 OR (EffRemote == 1 AND D_{f,WCHS} > 0) 
    eff_remote = f_meta["IsEffectiveRemote"]
    need_vertical = 1 if (d_wchc > 0) or (eff_remote == 1 and d_wchs > 0) else 0 # 
    
    # 3. Calculate fleet capacity requirement counts (Section 2 Capacity Constraints)
    # Simulates sending multiple assets or runs simultaneously to prevent SLA drop
    req_amb = max(
        int(np.ceil(d_seat / config["cap_ambulift_seat"])),
        int(np.ceil(d_own_chair / config["cap_ambulift_wc"]))
    ) if need_vertical == 1 else 0
    
    req_mini = max(
        int(np.ceil(d_seat / config["cap_minibus_seat"])),
        int(np.ceil(d_own_chair / config["cap_minibus_wc"]))
    )
    
    aggregated_flights.append({
        "flight_key": f_id,
        "Is_Arrival": int(f_meta["Is_Arrival"]),                # Arrival_f [cite: 35]
        "Sector_Domestic": int(f_meta["Sector_Domestic"]),      # Domestic_f [cite: 36]
        "IsRemote": int(f_meta["IsRemote"]),                    # Remote_f [cite: 34]
        "safety_stand": int(f_meta["safety_stand"]),            # Safety_f [cite: 36]
        "Chocks_DT_mins": int(f_meta["Chocks_DT_mins"]),        # T_{chocks,f} [cite: 38]
        "Boarding_DT_mins": int(f_meta["Boarding_DT_mins"]),    # T_{boarding,f} [cite: 39]
        "is_spin": int(f_meta["is_spin"]),
        "spin_parent_key": f_meta["spin_parent_key"],
        "total_prms": total_prms,
        "NeedVertical": need_vertical,                          # NeedVertical_f 
        "ReqAmb": req_amb,                                      # Required simultaneous Ambulifts
        "ReqMini": req_mini                                     # Required simultaneous Minibuses
    })

# ==========================================
# 4. INITIALIZE OPTIMIZATION CP MODEL
# ==========================================
model = cp_model.CpModel()
modes = ["SA", "CM", "CP", "SM", "SP"] # M [cite: 6]
MAX_TIME = 1440

# Variables maps
x = {}            # x_{f,m} [cite: 49]
t_start = {}      # t_{start,f} [cite: 50]
t_end = {}        # t_{end,f} [cite: 51]
is_breached = {}  # is_breached_f [cite: 52]
h = {}            # h_{a,d} (Spin pair turnaround hold option) [cite: 53]

# Global Capacity Trackers (Section 3 & User parameters)
N_ambulift = model.NewIntVar(0, 50, "N_ambulift") # N_v [cite: 48]
N_minibus = model.NewIntVar(0, 50, "N_minibus")   # N_v [cite: 48]
N_staff = model.NewIntVar(0, 200, "N_staff")     # User peak staff tracking variable

ambulift_intervals = []
minibus_intervals = []
staff_intervals = []

# ==========================================
# 5. CONSTRAINT INTERPRETATION LOOP
# ==========================================
for f in aggregated_flights:
    f_id = f["flight_key"]
    prms = f["total_prms"]
    
    # Establish Variable Objects
    t_start[f_id] = model.NewIntVar(0, MAX_TIME, f"t_start_{f_id}")
    t_end[f_id] = model.NewIntVar(0, MAX_TIME, f"t_end_{f_id}")
    is_breached[f_id] = model.NewBoolVar(f"is_breached_{f_id}")
    for m in modes:
        x[f_id, m] = model.NewBoolVar(f"x_{f_id}_{m}")

    # Framework Rule: Sum of modes assigned must equal exactly 1 [cite: 61]
    model.Add(sum(x[f_id, m] for m in modes) == 1)

    # --------------------------------------
    # Core Infrastructure & Domain Constraints (Section 5)
    # --------------------------------------
    # Constraint A: Pusher Mode Stand Restriction [cite: 69, 70]
    if f["IsRemote"] == 1:
        model.Add(x[f_id, "CP"] + x[f_id, "SP"] == 0)

    # Constraint B: Passenger-Driver Vertical Requirement Mapping [cite: 71, 72]
    if f["NeedVertical"] == 1:
        model.Add(x[f_id, "SA"] + x[f_id, "CM"] + x[f_id, "CP"] == 1)
    else:
        model.Add(x[f_id, "SM"] + x[f_id, "SP"] == 1)

    # Constraint C: Domestic Arrival Ambulift Exclusion [cite: 73, 74]
    if f["Is_Arrival"] == 1 and f["Sector_Domestic"] == 1:
        model.Add(x[f_id, "SA"] == 0)

    # Constraint D: Safety Stand Pusher Restrictions [cite: 75, 76]
    if f["safety_stand"] == 1:
        model.Add(x[f_id, "CP"] == 0)

    # --------------------------------------
    # SLA Temporal Search Space Constraints (Section 5)
    # --------------------------------------
    if f["Is_Arrival"] == 1:
        chocks = f["Chocks_DT_mins"]
        model.Add(t_start[f_id] >= chocks)
        # T_{start,f} <= T_{chocks,f} + T_{SLA} + (H_{SLA} - T_{SLA}) * is_breached_f [cite: 63]
        model.Add(t_start[f_id] <= chocks + config["sla_target_window"] + 
                  (config["sla_max_hard_limit"] - config["sla_target_window"]) * is_breached[f_id])
        model.Add(t_start[f_id] <= chocks + config["sla_max_hard_limit"]) # [cite: 63]
    else:
        boarding = f["Boarding_DT_mins"]
        # T_{end,f} <= T_{boarding,f} + (H_{SLA} - T_{SLA}) * is_breached_f [cite: 65]
        model.Add(t_end[f_id] <= boarding + (config["sla_max_hard_limit"] - config["sla_target_window"]) * is_breached[f_id])

    # --------------------------------------
    # Process Durations (Section 2)
    # --------------------------------------
    f_duration = model.NewIntVar(0, 120, f"duration_{f_id}")
    model.Add(f_duration == 
              config["duration_ambulift_solo"] * x[f_id, "SA"] +
              (config["duration_combined_ambulift"] + config["duration_minibus_transit"]) * x[f_id, "CM"] +
              (config["duration_combined_ambulift"] + config["duration_pusher_transit"]) * x[f_id, "CP"] +
              config["duration_minibus_transit"] * x[f_id, "SM"] +
              config["duration_pusher_transit"] * x[f_id, "SP"])
    model.Add(t_end[f_id] == t_start[f_id] + f_duration)

    # --------------------------------------
    # Capacity-Scaled Staffing Logic
    # --------------------------------------
    # Integrates your fixed vehicle requirements with crew-level addition rules
    f_staff = model.NewIntVar(0, 100, f"staff_{f_id}")
    model.Add(f_staff == 
              (config["staff_fixed_ambulift"] * f["ReqAmb"]) * x[f_id, "SA"] +
              ((config["staff_fixed_ambulift"] * f["ReqAmb"]) + (config["staff_fixed_minibus"] * f["ReqMini"])) * x[f_id, "CM"] +
              ((config["staff_fixed_ambulift"] * f["ReqAmb"]) + (config["staff_per_prm_pusher"] * prms)) * x[f_id, "CP"] +
              (config["staff_fixed_minibus"] * f["ReqMini"]) * x[f_id, "SM"] +
              (config["staff_per_prm_pusher"] * prms) * x[f_id, "SP"])

    # Base Operational Interval Profile
    flight_interval = model.NewIntervalVar(t_start[f_id], f_duration, t_end[f_id], f"int_{f_id}")
    staff_intervals.append((flight_interval, f_staff))

    # Vehicle-Specific Resource Allocations
    has_amb = model.NewBoolVar(f"has_amb_{f_id}")
    model.Add(has_amb == x[f_id, "SA"] + x[f_id, "CM"] + x[f_id, "CP"])
    
    # Track minibus metrics
    has_mini = model.NewBoolVar(f"has_mini_{f_id}")
    model.Add(has_mini == x[f_id, "CM"] + x[f_id, "SM"])

    # We store these conditionally for the Spin Turnaround Asset Hold logic below
    f["has_amb_var"] = has_amb
    f["has_mini_var"] = has_mini
    f["flight_interval"] = flight_interval

# ==========================================
# 6. SPIN TURNAROUND ASSIGNMENT LOGIC (h_ad)
# ==========================================
# Process linked arrival and departure pairings
for f in aggregated_flights:
    if f["is_spin"] == 1 and f["spin_parent_key"] != "":
        parent_id = f["spin_parent_key"]
        parent_f = [p for p in aggregated_flights if p["flight_key"] == parent_id][0]
        child_id = f["flight_key"]
        
        # Turnaround Sequence Rule: Departure cannot board until arrival is clear [cite: 78, 79]
        model.Add(t_start[child_id] >= t_end[parent_id]) # [cite: 79]
        
        # Initialize Hold Asset Selector: h_{a,d} [cite: 53]
        pair_key = (parent_id, child_id)
        h[pair_key] = model.NewBoolVar(f"h_{parent_id}_{child_id}")
        
        # Can only hold asset if BOTH parent and child actively use Ambulifts
        model.Add(h[pair_key] <= parent_f["has_amb_var"])
        model.Add(h[pair_key] <= f["has_amb_var"])
        
        # Create a timeline interval capturing the held asset's continuous stand footprint
        held_duration = model.NewIntVar(0, MAX_TIME, f"held_dur_{parent_id}_{child_id}")
        model.Add(held_duration == t_end[child_id] - t_start[parent_id])
        
        # Held Interval is active if h_{a,d} == 1
        held_int = model.NewOptionalIntervalVar(t_start[parent_id], held_duration, t_end[child_id], h[pair_key], f"held_int_{parent_id}_{child_id}")
        ambulift_intervals.append((held_int, parent_f["ReqAmb"]))
        
        # Individual intervals are only added if the asset isn't being held continuously
        parent_alone_active = model.NewBoolVar(f"parent_alone_{parent_id}")
        model.Add(parent_alone_active == parent_f["has_amb_var"]).OnlyEnforceIf(h[pair_key].Not())
        model.Add(parent_alone_active == 0).OnlyEnforceIf(h[pair_key])
        
        child_alone_active = model.NewBoolVar(f"child_alone_{child_id}")
        model.Add(child_alone_active == f["has_amb_var"]).OnlyEnforceIf(h[pair_key].Not())
        model.Add(child_alone_active == 0).OnlyEnforceIf(h[pair_key])
        
        p_int = model.NewOptionalIntervalVar(t_start[parent_id], model.NewIntVar(0, 120, f"p_dur_{parent_id}"), t_end[parent_id], parent_alone_active, f"amb_p_{parent_id}")
        c_int = model.NewOptionalIntervalVar(t_start[child_id], model.NewIntVar(0, 120, f"c_dur_{child_id}"), t_end[child_id], child_alone_active, f"amb_c_{child_id}")
        
        ambulift_intervals.append((p_int, parent_f["ReqAmb"]))
        ambulift_intervals.append((c_int, f["ReqAmb"]))
        
    elif f["is_spin"] == 1 and f["spin_parent_key"] == "":
        # Has a spin sequence but is the parent node, handled inside the child lookup block
        pass
    else:
        # Standard unlinked standalone flight interval allocations
        amb_int = model.NewOptionalIntervalVar(t_start[f["flight_key"]], model.NewIntVar(0, 120, f"dur_a_{f['flight_key']}"), t_end[f['flight_key']], f["has_amb_var"], f"amb_std_{f['flight_key']}")
        ambulift_intervals.append((amb_int, f["ReqAmb"]))

    # Map Minibus demand timeline structures
    if f["is_spin"] == 0 or f["spin_parent_key"] == "":
        mini_int = model.NewOptionalIntervalVar(t_start[f["flight_key"]], model.NewIntVar(0, 120, f"dur_m_{f['flight_key']}"), t_end[f['flight_key']], f["has_mini_var"], f"mini_std_{f['flight_key']}")
        minibus_intervals.append((mini_int, f["ReqMini"]))

# ==========================================
# 7. GLOBAL BOUNDARY MANAGEMENT RULES
# ==========================================
# Global 98% SLA Compliance boundary limit rule [cite: 66, 67]
model.Add(sum(is_breached[f["flight_key"]] for f in aggregated_flights) <= int(0.02 * len(aggregated_flights)))

# Map Overlapping Resource Peaks via Cumulative Engine Trackers
model.AddCumulative([intv for intv, dem in ambulift_intervals], [dem for intv, dem in ambulift_intervals], N_ambulift)
model.AddCumulative([intv for intv, dem in minibus_intervals], [dem for intv, dem in minibus_intervals], N_minibus)
model.AddCumulative([intv for intv, dem in staff_intervals], [dem for intv, dem in staff_intervals], N_staff)

# ==========================================
# 8. MULTI-OBJECTIVE OPTIMIZATION EQUATION
# ==========================================
# Minimize procurement CapEx [cite: 55, 56] + apply downward pressure on peak labor footprint
model.Minimize(
    config["capex_ambulift"] * N_ambulift + 
    config["capex_minibus"] * N_minibus + 
    1000 * N_staff
)

# ==========================================
# 9. SOLVER EXECUTION & KPI PRINT OUTPUTS
# ==========================================
solver = cp_model.CpSolver()
solver.parameters.max_time_in_seconds = 30.0
status = solver.Solve(model)

if status == cp_model.OPTIMAL or status == cp_model.FEASIBLE:
    print("=" * 45)
    print("     CAPACITY-SCALED ENGINE OPTIMIZATION    ")
    print("=" * 45)
    print(f"Peak Ambulifts Required at Peak : {solver.Value(N_ambulift)}")
    print(f"Peak Minibuses Required at Peak : {solver.Value(N_minibus)}")
    print(f"Peak Operational Staff (FTE)    : {solver.Value(N_staff)}")
    print("-" * 45)
    
    total_breaches = sum(solver.Value(is_breached[f["flight_key"]]) for f in aggregated_flights)
    print(f"Total SLA Breaches Record       : {total_breaches} / {len(aggregated_flights)}")
    print("=" * 45)
    
    print("\nDetailed Flight Assignment Tracking Metrics:")
    for f in aggregated_flights:
        f_id = f["flight_key"]
        selected_mode = [m for m in modes if solver.Value(x[f_id, m]) == 1][0]
        print(f"Flight: {f_id} | Mode: {selected_mode} | NeedVertical: {f['NeedVertical']} | ReqAmb Assets: {f['ReqAmb']} | ReqMini Assets: {f['ReqMini']}")
else:
    print("Engine could not resolve a valid schedule assignment under current boundaries.")
